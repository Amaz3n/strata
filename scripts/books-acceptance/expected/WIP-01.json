    "late-bill-after-review-blocks-close": {
      "inputs": {
        "contractCents": 100000000,
        "retainagePercent": 0,
        "eacCents": 80000000,
        "period": "2026-07",
        "billCents": 20000000,
        "lateBillCents": 20000000
      },
      "expectedCloseBlockedAfterLateBill": true,
