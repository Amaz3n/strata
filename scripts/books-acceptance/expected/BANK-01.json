    "reopen-order-and-frozen-evidence": {
      "derivation": "A reconciled statement line cannot be edited while its statement is closed. With July and August closed, July's bank statement and accounting period cannot reopen before August's; reopening newest first and reclosing in order reproduces each statement's digest.",
      "expectedWrongOrderRefused": true,
      "expectedDigestsReproduced": true,
      "expectedClosedDescription": "Check 101",
      "expectedClosedEditRefused": true
    },
